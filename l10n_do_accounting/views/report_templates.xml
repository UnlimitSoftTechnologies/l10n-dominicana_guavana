<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--
        The fiscal data of the invoice (type, NCF, expiration and modified NCF).
        It is printed inside the body of the invoice document (see report_invoice.xml),
        never inside an external layout: that way it looks the same with every layout.
    -->
    <template id="fiscal_info">
        <h5 t-if="o.fiscal_type_id">
            <t t-if="o.fiscal_type_id.prefix == 'B13'">
                <span t-field="o.fiscal_type_id.name" />
            </t>
            <t t-else="">
                <t t-if="o.move_type in ['in_refund', 'out_refund', 'out_invoice'] and o.origin_out">
                    <span t-field="o.fiscal_type_id.name" />
                </t>
                <t t-else=""> Invoice of <span t-field="o.fiscal_type_id.name" />
                </t>
            </t>
        </h5>
        <div t-if="o.ref">
            <strong>
                <t t-if="'E' in o.fiscal_type_id.prefix">e-NCF:</t>
                <t t-else="">NCF:</t>
            </strong>
            <span t-field="o.ref" />
        </div>
        <div id="fiscal_exp_date"
            t-if="o.move_type in ['out_invoice','out_refund', 'in_invoice'] and o.state == 'posted' and o.ref
                 and o.fiscal_type_id and o.fiscal_type_id.prefix[1:] not in ('32','34','02')
                 and o.ncf_expiration_date">
            <strong>
                <t t-if="'E' in o.fiscal_type_id.prefix">e-NCF Expiration Date:</t>
                <t t-else="">NCF Expiration Date:</t>
            </strong>
            <span t-field="o.ncf_expiration_date" />
        </div>
        <div t-if="o.move_type in ['in_refund', 'out_refund', 'out_invoice'] and o.origin_out">
            <strong>Modified e-NCF:</strong>
            <span t-field="o.origin_out" />
        </div>
    </template>

    <!--
        The top of the invoice, as in the printed model of the DGII: the data of the company
        on the left, right under the logo, and the data of the e-CF on the right, in the same row.
    -->
    <template id="complete_fiscal_info">
        <div class="row pt-2 mb-4">
            <div class="col-6" name="fiscal_company_data">
                <strong class="d-block fs-5">
                    <span t-field="o.company_id.name" />
                </strong>
                <div t-if="o.company_id.vat">
                    <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'" />: <span
                        t-field="o.company_id.vat" />
                </div>
                <div t-field="o.company_id.partner_id"
                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}' />
                <div t-if="o.invoice_date">
                    <strong>Issue Date:</strong>
                    <span t-field="o.invoice_date" />
                </div>
                <div t-if="o.name and o.name != '/'">
                    <strong>Invoice Number:</strong>
                    <span t-field="o.name" />
                </div>
            </div>
            <div class="col-6 text-end" name="fiscal_ecf_data">
                <t t-call="l10n_do_accounting.fiscal_info" />
            </div>
        </div>
    </template>

    <!--
        Every layout of the company prints its own data of the company in its header
        (div name="company_address"). In a fiscal invoice they are printed at the top of the
        invoice, so the layout keeps only its logo. One inheritance for each layout; they
        do the same. The layout is also used by reports whose "o" is not an invoice (it can
        be the company), so the model is checked before asking for the fiscal field.
    -->
    <template id="external_layout_standard_inherited" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_boxed_inherited" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_bold_inherited" inherit_id="web.external_layout_bold">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_striped_inherited" inherit_id="web.external_layout_striped">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_folder_inherited" inherit_id="web.external_layout_folder">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_wave_inherited" inherit_id="web.external_layout_wave">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

    <template id="external_layout_bubble_inherited" inherit_id="web.external_layout_bubble">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">not (o and o._name == 'account.move' and o.is_l10n_do_fiscal_invoice)</attribute>
        </xpath>
    </template>

</odoo>

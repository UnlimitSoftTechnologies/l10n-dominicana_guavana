<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

    <xpath expr="//div[hasclass('row')]" position="replace" />

    <!--
      The top of the page is printed in the body, so it looks the same with every layout:
      the data of the company and of the e-CF in one row (as in the printed model of the DGII)
      and the customer right under it. The layout only keeps its logo.
    -->
    <xpath expr="//div[hasclass('page')]/t[@t-set='layout_document_title']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <xpath expr="//div[hasclass('page')]/t[@t-set='layout_document_title']" position="after">
      <t t-if="o.is_l10n_do_fiscal_invoice">
        <t t-call="l10n_do_accounting.complete_fiscal_info" />
      </t>
      <div class="mb-3" name="fiscal_customer">
        <div>
          <strong>Customer:</strong>
          <span t-field="o.partner_id.name" />
        </div>
        <div t-if="o.partner_id.vat">
          <strong>RNC:</strong>
          <span t-field="o.partner_id.vat" />
        </div>
      </div>
    </xpath>

    <xpath expr="//div[@name='reference']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <xpath expr="//div[@name='invoice_date']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <xpath expr="//div[@name='due_date']" position="attributes">
      <attribute name="t-if">not o.is_l10n_do_fiscal_invoice</attribute>
    </xpath>

    <!-- SUBTOTAL -->

    <!-- <xpath expr="//strong[hasclass('mr16')]" position="replace">
      <strong class="mr16">Subtotal Engraved</strong>
    </xpath> -->

  </template>

</odoo>